# Copy this file to config.toml for local/private dashboard settings.
# config.toml is ignored by git because it may contain legal contact data.

city = "Leverkusen"
input = "output/places.json"
output = "output/charts/leverkusen_dashboard.html"
site_domain = "leverkusen-maps-review-removals.de"
site_url = "https://leverkusen-maps-review-removals.de"
site_output = "public"

[legal]
# Set to false or remove this section to omit methodik/korrektur/impressum/datenschutz pages.
enabled = true
name = "Dein Name"
email = "kontakt@leverkusen-maps-review-removals.de"

address_lines = [
  "Musterstraße 1",
  "51373 Leverkusen",
  "Deutschland",
]

note = "Angaben gemäß § 5 TMG"
post_handler = "Dein Name"

[analytics]
# Optional Plausible Analytics settings. Remove this section to disable analytics.
# src = "https://plausible.io/js/script.js"
# domain = "leverkusen-maps-review-removals.de"

[places_api]
# Optional. Required only for `make scrape ARGS="--places-api-discovery ..."`.
api_key = ""
